{
  "name": "buildbudget",
  "version": "0.1.0",
  "private": true,
  "description": "BuildBudget monorepo for construction budget estimation and supplier marketplace.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @buildbudget/web",
    "build:web": "npm run build -w @buildbudget/web",
    "preview:web": "npm run preview -w @buildbudget/web",
    "typecheck": "npm run typecheck -w @buildbudget/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
